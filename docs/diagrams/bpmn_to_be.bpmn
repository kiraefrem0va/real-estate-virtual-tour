      <bpmndi:BPMNEdge id="as_n1_di" bpmnElement="as_n1"><di:waypoint x="1005" y="350" /><di:waypoint x="1050" y="340" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
