      <bpmndi:BPMNEdge id="f15_di" bpmnElement="f15"><di:waypoint x="1690" y="155" /><di:waypoint x="1690" y="220" /><di:waypoint x="1822" y="220" /><bpmndi:BPMNLabel><dc:Bounds x="1696" y="159" width="30" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
