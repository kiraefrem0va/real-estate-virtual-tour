      <bpmndi:BPMNShape id="b3_di" bpmnElement="b3" bioc:fill="#dbe8f8" bioc:stroke="#2f5f9e" color:background-color="#dbe8f8" color:border-color="#2f5f9e"><dc:Bounds x="575" y="90" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="b4_di" bpmnElement="b4" bioc:fill="#dbe8f8" bioc:stroke="#2f5f9e" color:background-color="#dbe8f8" color:border-color="#2f5f9e"><dc:Bounds x="725" y="90" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1" bioc:fill="#dbe8f8" bioc:stroke="#2f5f9e" color:background-color="#dbe8f8" color:border-color="#2f5f9e"><dc:Bounds x="725" y="310" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="b5_di" bpmnElement="b5" bioc:fill="#dbe8f8" bioc:stroke="#2f5f9e" color:background-color="#dbe8f8" color:border-color="#2f5f9e"><dc:Bounds x="875" y="90" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2" bioc:fill="#dbe8f8" bioc:stroke="#2f5f9e" color:background-color="#dbe8f8" color:border-color="#2f5f9e"><dc:Bounds x="875" y="310" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m1_di" bpmnElement="m1" bioc:fill="#dbe8f8" bioc:stroke="#2f5f9e" color:background-color="#dbe8f8" color:border-color="#2f5f9e"><dc:Bounds x="875" y="550" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m2_di" bpmnElement="m2" bioc:fill="#dbe8f8" bioc:stroke="#2f5f9e" color:background-color="#dbe8f8" color:border-color="#2f5f9e"><dc:Bounds x="1025" y="550" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m3_di" bpmnElement="m3" bioc:fill="#dbe8f8" bioc:stroke="#2f5f9e" color:background-color="#dbe8f8" color:border-color="#2f5f9e"><dc:Bounds x="1175" y="550" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m4_di" bpmnElement="m4" bioc:fill="#dbe8f8" bioc:stroke="#2f5f9e" color:background-color="#dbe8f8" color:border-color="#2f5f9e"><dc:Bounds x="1325" y="550" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="b6_di" bpmnElement="b6" bioc:fill="#dbe8f8" bioc:stroke="#2f5f9e" color:background-color="#dbe8f8" color:border-color="#2f5f9e"><dc:Bounds x="1325" y="90" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m5_di" bpmnElement="m5" bioc:fill="#dbe8f8" bioc:stroke="#2f5f9e" color:background-color="#dbe8f8" color:border-color="#2f5f9e"><dc:Bounds x="1475" y="550" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true" bioc:fill="#fff59d" bioc:stroke="#827717" color:background-color="#fff59d" color:border-color="#827717"><dc:Bounds x="1665" y="105" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1640" y="73" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1" bioc:fill="#ef9a9a" bioc:stroke="#b71c1c" color:background-color="#ef9a9a" color:border-color="#b71c1c"><dc:Bounds x="1822" y="112" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1790" y="153" width="100" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e2_di" bpmnElement="e2" bioc:fill="#ef9a9a" bioc:stroke="#b71c1c" color:background-color="#ef9a9a" color:border-color="#b71c1c"><dc:Bounds x="1822" y="202" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1790" y="243" width="100" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="db_di" bpmnElement="db" bioc:fill="#eeeeee" bioc:stroke="#555555" color:background-color="#eeeeee" color:border-color="#555555"><dc:Bounds x="840" y="415" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="820" y="469" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n1_di" bpmnElement="n1"><dc:Bounds x="1050" y="315" width="220" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f0_di" bpmnElement="f0"><di:waypoint x="208" y="130" /><di:waypoint x="275" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="405" y="130" /><di:waypoint x="425" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="555" y="130" /><di:waypoint x="575" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="705" y="130" /><di:waypoint x="725" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="790" y="170" /><di:waypoint x="790" y="310" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="855" y="350" /><di:waypoint x="865" y="350" /><di:waypoint x="865" y="130" /><di:waypoint x="875" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="940" y="170" /><di:waypoint x="940" y="310" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="940" y="390" /><di:waypoint x="940" y="550" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="1005" y="590" /><di:waypoint x="1025" y="590" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="1155" y="590" /><di:waypoint x="1175" y="590" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="1305" y="590" /><di:waypoint x="1325" y="590" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11"><di:waypoint x="1390" y="550" /><di:waypoint x="1390" y="170" /></bpmndi:BPMNEdge>
